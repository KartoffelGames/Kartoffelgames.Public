{
    "name": "@kartoffelgames/web-potato-web-builder",
    "version": "1.0.1",
    "license": "LGPL-3.0-only",
    "tasks": {},
    "imports": {
        "@std/testing": "jsr:@std/testing@^1.0.9",
        "@std/expect": "jsr:@std/expect@^1.0.13"
    },
    "exports": "./source/index.ts",
    "publish": {
        "include": [
            "source/",
            "deno.json",
            "LICENSE"
        ]
    },
    "kg": {
        "name": "Kartoffelgames.Web.Potato_Web_Builder",
        "root": false,
        "config": {
            "package-blueprint": "kg-main",
            "scratchpad": {
                "port": 8088,
                "mimeTypeMapping": {},
                "directory": "./scratchpad",
                "build": false
            },
            "page": {
                "port": 8088,
                "mimeTypeMapping": {},
                "directory": "./page"
            },
            "test": {
                "directory": "./test"
            },
            "build": {
                "files": {
                    "./page/source/index.ts": {
                        "type": "page",
                        "output": "./page/bundle/page.js"
                    }
                }
            }
        },
        "source": "./source"
    }
}