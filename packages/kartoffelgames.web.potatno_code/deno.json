{
    "name": "@kartoffelgames/web-potatno-code",
    "version": "1.0.1",
    "license": "LGPL-3.0-only",
    "tasks": {},
    "imports": {
        "@std/testing": "jsr:@std/testing@^1.0.9",
        "@std/expect": "jsr:@std/expect@^1.0.13"
    },
    "exports": {
        ".": "./source/index.ts"
    },
    "publish": {
        "include": [
            "source/",
            "deno.json",
            "LICENSE"
        ]
    },
    "kg": {
        "name": "Kartoffelgames.Web.Potatno_Code",
        "config": {
            "package-blueprint": "kg-main",
            "build": {
                "files": {
                    "./page/source/index.ts": {
                        "type": "page",
                        "output": "./page/bundle/page.js"
                    }
                }
            },
            "scratchpad": {
                "directory": "./scratchpad",
                "mimeTypeMapping": {},
                "build": false,
                "port": 8088
            },
            "page": {
                "directory": "./page",
                "mimeTypeMapping": {},
                "port": 8088
            },
            "test": {
                "directory": "./test"
            }
        },
        "source": "./source"
    }
}